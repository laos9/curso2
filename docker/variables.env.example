# Las variables que Compose necesita.
#
# NO es un archivo aparte: estas lineas se AGREGAN al final de tu .env,
# el mismo que ya usa Laravel. Compose lee ese archivo solo, sin que le
# digas nada, y asi tienes un solo lugar con la configuracion.
#
# Tu .env no se sube a Git ni entra a las imagenes. Este ejemplo si se sube:
# es el que le dice a quien clone el proyecto que nombres hacen falta.
#
# APP_KEY no esta aqui porque ya la tienes: es la de Laravel, y Compose
# la reusa tal cual.

# Un nombre distinto por persona evita que choquen los contenedores
COMPOSE_PROJECT_NAME=avisos-tunombre

# Los puertos de tu maquina. Si alguno esta ocupado, cambialo aqui
PUERTO_ANGULAR=8080
PUERTO_LARAVEL=8081
PUERTO_DJANGO=8082

# La base de datos, compartida por los dos proyectos
BD_LARAVEL=avisos_laravel
BD_DJANGO=avisos_django
BD_USUARIO=avisos
BD_CLAVE=CAMBIAME_por_una_clave_larga

# Django
DJANGO_SECRET_KEY=CAMBIAME_por_una_clave_larga_y_distinta
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,django,angular
